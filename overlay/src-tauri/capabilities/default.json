{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Exactly what the overlay page calls: its own commands, window drag, events, and the two global hotkeys.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "global-shortcut:allow-is-registered"
  ]
}
